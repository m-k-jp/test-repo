---
import ThemeToggle from '../components/ThemeToggle.astro';
import Sidebar from '../components/Sidebar.astro';
import SidebarToggle from '../components/SidebarToggle.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`} />
    <title>{title}</title>

    {/*
      保存済みの配色を「最初の描画より前」に適用する。
      Astro が生成する通常の <script> は type="module" となり遅延実行されるため、
      ダーク設定の人に白い画面が一瞬見えてしまう。それを防ぐため is:inline を使う。
    */}
    <script is:inline>
      (function () {
        const root = document.documentElement;
        root.classList.add('js');
        try {
          const saved = localStorage.getItem('theme');
          if (saved === 'dark' || saved === 'light') root.dataset.theme = saved;
        } catch {
          /* localStorage が使えない環境ではシステム設定に従う */
        }

        // サイドペインの初期状態。広い画面は開、狭い画面は閉が既定。
        // 描画後に決めると開閉のアニメーションが一瞬見えるため、ここで確定させる。
        let sidebar = null;
        try {
          sidebar = localStorage.getItem('sidebar');
        } catch {
          /* 読めない場合は画面幅で決める */
        }
        if (sidebar !== 'open' && sidebar !== 'closed') {
          sidebar = window.matchMedia('(min-width: 60rem)').matches ? 'open' : 'closed';
        }
        root.dataset.sidebar = sidebar;
      })();
    </script>
  </head>
  <body>
    <SidebarToggle />
    <Sidebar />
    <ThemeToggle />
    <div class="content">
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>

<style is:global>
  /*
    配色の定義は3か所に分かれる。
      1. :root                        … ライト（既定値）
      2. @media (prefers-color-scheme) … OS がダークのとき
      3. :root[data-theme="dark"]      … 明示的にダークを選んだとき
    2 に :not([data-theme="light"]) を付けているのは、
    OS がダークでも「ライト」を明示した人にはライトを出すため。
  */
  :root {
    color-scheme: light;
    --bg: #ffffff;
    --fg: #1a1a1a;
    --muted: #666666;
    --border: #e2e1dd;
    --surface-2: #f0efec;
    --accent: #2a78d6;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      color-scheme: dark;
      --bg: #16171a;
      --fg: #f2f2f2;
      --muted: #a0a0a0;
      --border: #2f3034;
      --surface-2: #26272b;
      --accent: #3987e5;
    }
  }

  :root[data-theme='dark'] {
    color-scheme: dark;
    --bg: #16171a;
    --fg: #f2f2f2;
    --muted: #a0a0a0;
    --border: #2f3034;
    --surface-2: #26272b;
    --accent: #3987e5;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: system-ui, -apple-system, "Hiragino Sans", "Noto Sans JP", sans-serif;
    line-height: 1.8;
  }

  /* サイドペインの幅。ここを変えれば本文の押し出し量も追従する */
  :root {
    --sidebar-w: 17rem;
  }

  main {
    max-width: 42rem;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }

  /*
    広い画面ではサイドペインが本文を押し出す。
    狭い画面では本文の上に覆いかぶさるので、押し出しは行わない。
  */
  @media (min-width: 60rem) {
    .content {
      transition: padding-left 0.22s ease;
    }

    :root[data-sidebar='open'] .content {
      padding-left: var(--sidebar-w);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .content {
      transition: none;
    }
  }

  h1 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .muted {
    color: var(--muted);
  }

  a {
    color: var(--accent);
  }

  /*
    コードブロックの配色。
    Shiki が light / dark 両方の値を CSS 変数として出力するので、
    配色トークンと同じ3スコープの考え方で dark 側に切り替える。
    Shiki はインラインスタイルで色を当てるため !important が要る。
  */
  /*
    背景は Shiki のテーマ由来の色ではなくサイトのトークンを使う。
    github-light の背景は純白で、ライトモードだとページと同化して
    コードブロックだと分からなくなるため。
  */
  .astro-code {
    background-color: var(--surface-2) !important;
    border: 1px solid var(--border);
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .astro-code,
    :root:not([data-theme='light']) .astro-code span {
      color: var(--shiki-dark) !important;
    }
  }

  :root[data-theme='dark'] .astro-code,
  :root[data-theme='dark'] .astro-code span {
    color: var(--shiki-dark) !important;
  }
</style>
