---
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`} />
    <title>{title}</title>

    {/*
      保存済みの配色を「最初の描画より前」に適用する。
      Astro が生成する通常の <script> は type="module" となり遅延実行されるため、
      ダーク設定の人に白い画面が一瞬見えてしまう。それを防ぐため is:inline を使う。
    */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'dark' || saved === 'light') root.dataset.theme = saved;
        } catch (e) {
          /* localStorage が使えない環境ではシステム設定に従う */
        }
      })();
    </script>
  </head>
  <body>
    <ThemeToggle />
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  /*
    配色の定義は3か所に分かれる。
      1. :root                        … ライト（既定値）
      2. @media (prefers-color-scheme) … OS がダークのとき
      3. :root[data-theme="dark"]      … 明示的にダークを選んだとき
    2 に :not([data-theme="light"]) を付けているのは、
    OS がダークでも「ライト」を明示した人にはライトを出すため。
  */
  :root {
    color-scheme: light;
    --bg: #ffffff;
    --fg: #1a1a1a;
    --muted: #666666;
    --border: #e2e1dd;
    --surface-2: #f0efec;
    --accent: #2a78d6;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      color-scheme: dark;
      --bg: #16171a;
      --fg: #f2f2f2;
      --muted: #a0a0a0;
      --border: #2f3034;
      --surface-2: #26272b;
      --accent: #3987e5;
    }
  }

  :root[data-theme='dark'] {
    color-scheme: dark;
    --bg: #16171a;
    --fg: #f2f2f2;
    --muted: #a0a0a0;
    --border: #2f3034;
    --surface-2: #26272b;
    --accent: #3987e5;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: system-ui, -apple-system, "Hiragino Sans", "Noto Sans JP", sans-serif;
    line-height: 1.8;
  }

  main {
    max-width: 42rem;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }

  h1 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .muted {
    color: var(--muted);
  }

  a {
    color: var(--accent);
  }
</style>
