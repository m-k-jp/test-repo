---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { memoTitle, memoDate, formatDate, memoExcerpt, sortMemos } from '../../lib/memo';
import Thumbnail from '../../components/Thumbnail.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const memos = sortMemos(await getCollection('memo'));
---

<Layout title="ノート">
  <p class="back"><a href={`${base}/`}>← トップへ</a></p>

  <h1>ノート</h1>
  <p class="muted">リポジトリ直下の <code>memo/</code> に置いた Markdown が、そのままノートになります。</p>

  {memos.length === 0 ? (
    <p>まだノートがありません。</p>
  ) : (
    <ul class="memo-list">
      {memos.map((entry) => {
        return (
          <li>
            <a href={`${base}/memo/${entry.id}/`}>
              <Thumbnail entry={entry} title={memoTitle(entry)} size="76px" />
              <span class="body">
                <span class="title">{memoTitle(entry)}</span>
                {memoDate(entry) && <time datetime={memoDate(entry)!.toISOString()}>{formatDate(memoDate(entry))}</time>}
                <span class="excerpt">{memoExcerpt(entry)}</span>
                {entry.data.tags && entry.data.tags.length > 0 && (
                  <span class="tags">{entry.data.tags.map((t) => <span>{t}</span>)}</span>
                )}
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  )}

  <h2>使い方</h2>
  <p><code>memo/</code> フォルダに <code>.md</code> ファイルを置いて push するだけです。ファイルを <code>src/</code> に移す必要はありません。フロントマターも必須ではなく、素の Markdown で構いません。</p>
  <p>タイトルは本文の最初の見出しから、日付はファイル名の <code>YYYY-MM-DD</code> から自動で拾います。明示したい場合だけ、先頭にフロントマターを書けばそちらが優先されます。</p>

  <pre><code>---
title: 好きなタイトル
date: 2026-08-27
tags: [メモ]
draft: false
---</code></pre>

  <p><code>draft: true</code> にすると一覧から外れます。</p>

  <p class="muted back"><a href={`${base}/`}>← トップへ</a></p>
</Layout>

<style>
  h2 { margin-top: 3rem; font-size: 1.25rem; }
  .back a { color: inherit; }

  .memo-list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
  }

  .memo-list li {
    border-bottom: 1px solid color-mix(in srgb, currentColor 15%, transparent);
  }

  .memo-list li:last-child {
    border-bottom: none;
  }

  .memo-list a {
    display: flex;
    gap: 0.9rem;
    padding: 1rem 0.5rem;
    margin: 0 -0.5rem;
    border-radius: 10px;
    color: inherit;
    text-decoration: none;
  }

  .memo-list a:hover {
    background: color-mix(in srgb, currentColor 6%, transparent);
  }

  .body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .title {
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.5;
  }

  time {
    font-size: 0.75rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .excerpt {
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.35rem;
  }

  .tags span {
    font-size: 0.7rem;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--muted);
  }

  pre {
    background: color-mix(in srgb, currentColor 8%, transparent);
    padding: 1rem;
    border-radius: 6px;
    overflow-x: auto;
    font-size: 0.9rem;
  }

  code { font-size: 0.9em; }
</style>
