---
import { getCollection } from 'astro:content';
import { memoTitle, memoDate, sortMemos } from '../lib/memo';
import Thumbnail from './Thumbnail.astro';

/**
 * 左のサイドペイン。ノート（記事）を新しい順に並べる。
 *
 * 広い画面では開いた状態、狭い画面では隠れた状態が既定。
 * 開閉はヘッダーのボタンで行い、選択は localStorage に保存する
 * （初回描画前の適用は Layout.astro の is:inline スクリプトが担当）。
 */

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const memos = sortMemos(await getCollection('memo'));

// 件数が増えると平坦な一覧は探しにくいので、年月で区切る。
// 日付が無いノートは末尾にまとめる。
const groups: { label: string; items: typeof memos }[] = [];
for (const entry of memos) {
  const d = memoDate(entry);
  const label = d ? `${d.getFullYear()}年${d.getMonth() + 1}月` : '日付なし';
  const last = groups.at(-1);
  if (last?.label === label) last.items.push(entry);
  else groups.push({ label, items: [entry] });
}

// 現在開いているページを強調するため、末尾スラッシュを揃えて比較する
const here = Astro.url.pathname.replace(/\/$/, '');
---

<div class="scrim" data-sidebar-close aria-hidden="true"></div>

<aside id="sidebar" aria-label="ノート一覧">
  <div class="head">
    <a href={`${base}/`} class="site">test-repo</a>
  </div>

  <nav>
    <p class="section">ノート</p>

    {memos.length === 0 ? (
      <p class="empty">まだノートがありません</p>
    ) : (
      groups.map((g) => (
        <>
          <p class="month">{g.label}</p>
          <ul>
            {g.items.map((entry) => {
              const href = `${base}/memo/${entry.id}`;
              return (
                <li>
                  <a href={`${href}/`} aria-current={here === href ? 'page' : undefined}>
                    <Thumbnail entry={entry} title={memoTitle(entry)} size="36px" />
                    <span class="text">
                      <span class="title">{memoTitle(entry)}</span>
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </>
      ))
    )}

    <p class="section">ページ</p>
    <ul class="plain">
      <li><a href={`${base}/memo/`} aria-current={here === `${base}/memo` ? 'page' : undefined}>ノート一覧</a></li>
      <li><a href={`${base}/demo/`} aria-current={here === `${base}/demo` ? 'page' : undefined}>3D デモ</a></li>
      <li><a href={`${base}/charts/`} aria-current={here === `${base}/charts` ? 'page' : undefined}>グラフのデモ</a></li>
    </ul>
  </nav>
</aside>

<script is:inline>
  // 一覧の下のほうにあるノートを開いたとき、ペインは先頭を向いたままになる。
  // 描画が終わる前に現在地へ寄せておくことで、スクロールが跳ねて見えるのを防ぐ。
  (function () {
    const pane = document.getElementById('sidebar');
    const list = pane && pane.querySelector('nav');
    const current = list && list.querySelector('a[aria-current="page"]');
    if (!current) return;
    const offset = current.offsetTop - list.clientHeight / 2 + current.clientHeight / 2;
    list.scrollTop = Math.max(0, offset);
  })();
</script>

<style>
  aside {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 30;
    width: var(--sidebar-w);
    height: 100dvh;
    display: flex;
    flex-direction: column;
    background: var(--surface-2);
    border-right: 1px solid var(--border);
    /* スクロールするのは nav だけ。見出しは上に留める */
    overflow: hidden;
    /* 既定は隠した状態。開いているときだけ 0 に戻す */
    transform: translateX(-100%);
    transition: transform 0.22s ease;
  }

  :global(html[data-sidebar='open']) aside {
    transform: translateX(0);
  }

  /* 画面を覆う膜。狭い画面で開いたときだけ出す */
  .scrim {
    position: fixed;
    inset: 0;
    z-index: 25;
    background: rgb(0 0 0 / 0.4);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.22s ease;
  }

  :global(html[data-sidebar='open']) .scrim {
    opacity: 1;
    pointer-events: auto;
  }

  /* 広い画面では本文を押し出す形にするので、膜は出さない */
  @media (min-width: 60rem) {
    :global(html[data-sidebar='open']) .scrim {
      opacity: 0;
      pointer-events: none;
    }
  }

  .head {
    flex: none;
    padding: 1rem 1rem 0.5rem;
    /* 開閉ボタンと重ならないよう左に余白を取る */
    padding-left: 3.5rem;
    background: var(--surface-2);
  }

  .site {
    font-weight: 650;
    font-size: 0.95rem;
    color: var(--fg);
    text-decoration: none;
  }

  nav {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0 0.6rem 2rem;
  }

  .month {
    position: sticky;
    top: 0;
    z-index: 1;
    margin: 0.8rem 0 0.3rem;
    padding: 0.25rem 0.4rem;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--muted);
    background: var(--surface-2);
  }

  .section {
    margin: 1.4rem 0 0.4rem;
    padding: 0 0.4rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /*
    画面外の項目は描画処理そのものを省く。
    HTML には全件が入ったままなので、JS 無効でも検索でも欠けない。
    contain-intrinsic-size で高さを見積もらせ、スクロールバーが跳ねるのを防ぐ。
  */
  li {
    content-visibility: auto;
    contain-intrinsic-size: auto 3.2rem;
  }

  li a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.4rem;
    border-radius: 8px;
    color: var(--fg);
    text-decoration: none;
    line-height: 1.4;
  }

  li a:hover {
    background: color-mix(in srgb, var(--fg) 8%, transparent);
  }

  li a[aria-current='page'] {
    background: color-mix(in srgb, var(--accent) 16%, transparent);
  }

  .text {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .title {
    font-size: 0.85rem;
    /* 長いタイトルは2行で打ち切る */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .plain a {
    font-size: 0.85rem;
    padding-left: 0.5rem;
  }

  .empty {
    padding: 0 0.4rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    aside,
    .scrim {
      transition: none;
    }
  }
</style>
