---
import { getCollection } from 'astro:content';
import { sortMemos, memoDate } from '../lib/memo';
import { renderNoteItem, renderMonthHeading, monthLabel } from '../lib/note-item';
import { CHUNK } from '../pages/notes/[page].json';
import '../styles/notes.css';

/**
 * 左のサイドペイン。ノートを新しい順に並べる。
 *
 * 全件を埋め込むと出力サイズがノート数の2乗で増えるため、
 * HTML に入れるのは最初の1塊だけ。
 * 続きはスクロールが末尾に近づいたときに JSON から取りに行く。
 */

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const all = sortMemos(await getCollection('memo'));
const first = all.slice(0, CHUNK);
const hasNext = all.length > CHUNK;

// 現在開いているページを強調するため、末尾スラッシュを揃えて比較する
const here = Astro.url.pathname.replace(/\/$/, '');
const currentEntry = all.find((e) => here === `${base}/memo/${e.id}`);

// 最初の塊に含まれない記事を開いている場合、その1件だけ先頭に添えて
// 「いまどこにいるか」が分かるようにする
const pinned =
  currentEntry && !first.includes(currentEntry) ? currentEntry : undefined;

let listHtml = '';
let label = '';
let open = false;
for (const entry of first) {
  const m = monthLabel(memoDate(entry));
  if (m !== label) {
    if (open) listHtml += '</ul>';
    listHtml += renderMonthHeading(m) + '<ul>';
    label = m;
    open = true;
  }
  listHtml += renderNoteItem(entry, base, entry === currentEntry);
}
if (open) listHtml += '</ul>';
---

<div class="scrim" data-sidebar-close aria-hidden="true"></div>

<aside id="sidebar" aria-label="ノート一覧">
  <div class="head">
    <a href={`${base}/`} class="site">test-repo</a>
  </div>

  <nav>
    {pinned && (
      <>
        <p class="month">開いているノート</p>
        <ul set:html={renderNoteItem(pinned, base, true)} />
      </>
    )}

    {all.length === 0 ? (
      <p class="empty">まだノートがありません</p>
    ) : (
      <Fragment set:html={listHtml} />
    )}

    {hasNext && <div id="notes-more" data-next="1" aria-hidden="true"></div>}

    <p class="section">ページ</p>
    <ul class="plain">
      <li><a href={`${base}/memo/`} aria-current={here === `${base}/memo` ? 'page' : undefined}>ノート一覧</a></li>
      <li><a href={`${base}/demo/`} aria-current={here === `${base}/demo` ? 'page' : undefined}>3D デモ</a></li>
      <li><a href={`${base}/charts/`} aria-current={here === `${base}/charts` ? 'page' : undefined}>グラフのデモ</a></li>
    </ul>
  </nav>
</aside>

<script is:inline>
  // 現在地へ寄せる。描画が終わる前に走らせて、スクロールが跳ねて見えるのを防ぐ。
  (function () {
    const pane = document.getElementById('sidebar');
    const list = pane && pane.querySelector('nav');
    const current = list && list.querySelector('a[aria-current="page"]');
    if (!current) return;
    const offset = current.offsetTop - list.clientHeight / 2 + current.clientHeight / 2;
    list.scrollTop = Math.max(0, offset);
  })();
</script>

<script>
  // 末尾に近づいたら続きを取りに行く。
  // 中身はビルド時に組み立て済みの HTML なので、ここでは差し込むだけ。
  const sentinel = document.getElementById('notes-more');
  const nav = document.querySelector('#sidebar nav');

  if (sentinel && nav) {
    const base = document.documentElement.dataset.base ?? '';
    let loading = false;

    const loadNext = async () => {
      const next = sentinel.dataset.next;
      if (loading || !next) return;
      loading = true;
      try {
        const res = await fetch(`${base}/notes/${next}.json`);
        if (!res.ok) throw new Error(String(res.status));
        const data = await res.json();
        sentinel.insertAdjacentHTML('beforebegin', data.html);
        if (data.hasNext) sentinel.dataset.next = String(Number(next) + 1);
        else delete sentinel.dataset.next;
      } catch {
        // 取得に失敗しても一覧ページから全件たどれるので、ここでは黙って諦める
        delete sentinel.dataset.next;
      } finally {
        loading = false;
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) loadNext();
      },
      { root: nav, rootMargin: '400px' },
    );
    observer.observe(sentinel);
  }
</script>

<style>
  aside {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 30;
    width: var(--sidebar-w);
    height: 100dvh;
    display: flex;
    flex-direction: column;
    background: var(--surface-2);
    border-right: 1px solid var(--border);
    /* スクロールするのは nav だけ。見出しは上に留める */
    overflow: hidden;
    /* 既定は隠した状態。開いているときだけ 0 に戻す */
    transform: translateX(-100%);
    transition: transform 0.22s ease;
  }

  :global(html[data-sidebar='open']) aside {
    transform: translateX(0);
  }

  /* 画面を覆う膜。狭い画面で開いたときだけ出す */
  .scrim {
    position: fixed;
    inset: 0;
    z-index: 25;
    background: rgb(0 0 0 / 0.4);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.22s ease;
  }

  :global(html[data-sidebar='open']) .scrim {
    opacity: 1;
    pointer-events: auto;
  }

  /* 広い画面では本文を押し出す形にするので、膜は出さない */
  @media (min-width: 60rem) {
    :global(html[data-sidebar='open']) .scrim {
      opacity: 0;
      pointer-events: none;
    }
  }

  .head {
    flex: none;
    padding: 1rem 1rem 0.5rem;
    /* 開閉ボタンと重ならないよう左に余白を取る */
    padding-left: 3.5rem;
    background: var(--surface-2);
  }

  .site {
    font-weight: 650;
    font-size: 0.95rem;
    color: var(--fg);
    text-decoration: none;
  }

  nav {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0 0.6rem 2rem;
  }

  .section {
    margin: 1.4rem 0 0.4rem;
    padding: 0 0.4rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  .plain {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .plain a {
    display: block;
    font-size: 0.85rem;
    padding: 0.45rem 0.5rem;
    border-radius: 8px;
    color: var(--fg);
    text-decoration: none;
  }

  .plain a:hover {
    background: color-mix(in srgb, var(--fg) 8%, transparent);
  }

  .plain a[aria-current='page'] {
    background: color-mix(in srgb, var(--accent) 16%, transparent);
  }

  .empty {
    padding: 0 0.4rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    aside,
    .scrim {
      transition: none;
    }
  }
</style>
