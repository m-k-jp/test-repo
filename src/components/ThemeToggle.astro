---
/**
 * 配色の切り替え（ライト / ダーク / システムに従う）。
 *
 * 選択は localStorage に保存する。
 * 「システム」を選んだときはキーごと削除し、値が無い状態＝システム追従とする。
 * 初回描画前の適用は Layout.astro の is:inline スクリプトが担当する。
 */
---

<div class="theme-toggle" role="group" aria-label="配色">
  <button type="button" data-mode="light" aria-pressed="false">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="4.2" />
      <path d="M12 2.5v2.2M12 19.3v2.2M4.2 4.2l1.6 1.6M18.2 18.2l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.2 19.8l1.6-1.6M18.2 5.8l1.6-1.6" />
    </svg>
    <span>ライト</span>
  </button>

  <button type="button" data-mode="dark" aria-pressed="false">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M20 13.2A8.2 8.2 0 0 1 10.8 4a8.2 8.2 0 1 0 9.2 9.2Z" />
    </svg>
    <span>ダーク</span>
  </button>

  <button type="button" data-mode="system" aria-pressed="false">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <rect x="2.8" y="4.5" width="18.4" height="12.5" rx="1.8" />
      <path d="M9 20.5h6" />
    </svg>
    <span>システム</span>
  </button>
</div>

<script>
  const STORAGE_KEY = 'theme';
  const root = document.documentElement;
  const buttons = document.querySelectorAll<HTMLButtonElement>('.theme-toggle button');

  const current = (): string => {
    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved === 'light' || saved === 'dark') return saved;
    } catch {
      /* プライベートモードなどで localStorage が使えない場合はシステム追従 */
    }
    return 'system';
  };

  const sync = (mode: string) => {
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === mode)));
  };

  const apply = (mode: string) => {
    if (mode === 'system') {
      delete root.dataset.theme;
    } else {
      root.dataset.theme = mode;
    }

    try {
      if (mode === 'system') localStorage.removeItem(STORAGE_KEY);
      else localStorage.setItem(STORAGE_KEY, mode);
    } catch {
      /* 保存できなくても、そのページ内での切り替えは効かせる */
    }

    sync(mode);
    // canvas は CSS 変数で色を変えられないため、グラフ側に切り替えを通知する
    window.dispatchEvent(new CustomEvent('themechange', { detail: { mode } }));
  };

  sync(current());
  buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.mode!)));

  // 別のタブで切り替えられたときに追従する
  window.addEventListener('storage', (e) => {
    if (e.key !== STORAGE_KEY) return;
    const mode = current();
    if (mode === 'system') delete root.dataset.theme;
    else root.dataset.theme = mode;
    sync(mode);
    window.dispatchEvent(new CustomEvent('themechange', { detail: { mode } }));
  });
</script>

<style>
  .theme-toggle {
    position: fixed;
    top: 1rem;
    right: 1rem;
    z-index: 10;
    display: none; /* JS が無い環境では動かないので出さない */
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(8px);
  }

  /* is:inline スクリプトが html に js クラスを付けたときだけ表示する */
  :global(html.js) .theme-toggle {
    display: inline-flex;
  }

  button {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.65rem;
    border: none;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 0.78rem;
    line-height: 1;
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s;
  }

  button:hover {
    color: var(--fg);
  }

  button[aria-pressed='true'] {
    background: var(--surface-2);
    color: var(--fg);
  }

  button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex: none;
  }

  /* 画面が狭いときはアイコンだけにして場所を取らない */
  @media (max-width: 34rem) {
    span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    button {
      padding: 0.4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    button {
      transition: none;
    }
  }
</style>
