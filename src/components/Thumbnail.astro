---
import type { CollectionEntry } from 'astro:content';
import { thumbnail } from '../lib/thumbnail';
import { renderThumbnail } from '../lib/note-item';
import '../styles/notes.css';

interface Props {
  entry: CollectionEntry<'memo'>;
  title: string;
  /** 一辺の大きさ。単位付きで渡す（例: 36px, 4.25rem） */
  size: string;
}

const { entry, title, size } = Astro.props;

// 描画は note-item.ts の1か所に寄せてある。
// サイドペインの動的読み込みと同じ HTML がここでも使われる。
const html = renderThumbnail(thumbnail(entry, title), size);
---

<Fragment set:html={html} />
