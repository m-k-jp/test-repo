#!/bin/sh
#
# push の前に型検査を走らせる関門。
#
# Vite は型注釈を構文として除去するだけで検査しないため、
# 型エラーを含むコードでもビルドは成功してしまう。
# 「動くから正しい」とは限らないので、push の前にここで止める。
#
# 有効化は npm install 時に自動で行われる（package.json の prepare スクリプトが
# core.hooksPath を .githooks に向ける）。手動なら次の1回だけ:
#   git config core.hooksPath .githooks
#
# 緊急時に迂回する場合:
#   git push --no-verify

set -e

# 依存が未インストールだと検査できない。CI 側の関門に委ねて通す。
if [ ! -d node_modules ]; then
  echo "pre-push: node_modules が無いため型検査を省略します（npm ci を推奨）"
  exit 0
fi

echo "pre-push: 型検査を実行します (astro check)"

if npm run --silent check; then
  echo "pre-push: 型検査を通過しました"
  exit 0
fi

cat >&2 <<'MSG'

pre-push: 型検査に失敗したため push を中止しました。

  上のエラーを修正してから push し直してください。
  検査だけ再実行する場合:  npm run check
  検査とビルドをまとめて:  npm run verify

  意図的に迂回する場合のみ: git push --no-verify

MSG
exit 1
